# Application
SECRET_KEY=change-me-to-a-random-64-char-string
ALLOWED_ORIGINS=http://localhost:8000
APP_URL=http://localhost:8000

# Database (SQLite by default; set to PostgreSQL URL in production)
DATABASE_URL=sqlite+aiosqlite:///./migration_platform.db
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme

# Field-level encryption key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FIELD_ENCRYPTION_KEY=change-me-generate-with-fernet

# SMTP (email)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=noreply@migration-platform.local
SMTP_FROM_NAME=Migration Platform

# File uploads
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=25

# ClamAV (optional)
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Session
SESSION_EXPIRE_HOURS=24
